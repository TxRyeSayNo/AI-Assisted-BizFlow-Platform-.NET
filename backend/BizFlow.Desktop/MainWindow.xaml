<Window x:Class="BizFlow.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:BizFlow.Desktop.Views"
        mc:Ignorable="d"
        Title="BizFlow Platform — Hệ thống Quản trị Vận hành Doanh nghiệp AI (WPF Desktop)"
        Width="1480" Height="900"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/BizFlow.Desktop;component/Assets/favicon.ico"
        Background="{StaticResource SurfaceGroundBrush}">
    <Grid>
        <!-- ================================================================ -->
        <!-- 1. UNAUTHENTICATED VIEW (LOGIN / PASSWORDLESS / REGISTER)        -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding Session.IsSignedIn, Converter={StaticResource InverseBoolToVis}}">
            <views:AuthView DataContext="{Binding Auth}" />

            <!-- Live Backend Connectivity Pill at Bottom-Left of Login Screen -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,16"
                    Background="#CC0F2E4E" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="16" Padding="14,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Supervisor.StatusMessage}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================ -->
        <!-- 2. AUTHENTICATED ENTERPRISE SHELL                                -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding Session.IsSignedIn, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOP UTILITY HEADER BAR -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Logo + Tenant Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BizFlow.Desktop;component/Assets/bizflow-logo.png" Width="34" Height="34" Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BizFlow Platform" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" />
                            <TextBlock Text="AI-Assisted Enterprise Operations" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <Border Background="#EEF4FA" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Session.TenantDisplayLabel}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Live Backend Health Pill -->
                    <Border Grid.Column="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding Supervisor.StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Right Header Utility Actions -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🔍 Tra cứu" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="12" Margin="0,0,8,0"
                                Visibility="{Binding CanNavSearch, Converter={StaticResource BoolToVis}}"
                                Command="{Binding NavigateCommand}" CommandParameter="RecordSearch" />

                        <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="12" Margin="0,0,8,0"
                                Visibility="{Binding ShowTenantMenu, Converter={StaticResource BoolToVis}}"
                                Command="{Binding NavigateCommand}" CommandParameter="Notifications">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔔 Thông báo" VerticalAlignment="Center" />
                                <Border Background="{StaticResource DangerBrush}" CornerRadius="9" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Operations.UnreadCount}" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Content="🤖 Trợ lý AI" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" FontSize="12" Margin="0,0,14,0"
                                Visibility="{Binding ShowTenantMenu, Converter={StaticResource BoolToVis}}"
                                Command="{Binding ToggleAiAssistantCommand}" />

                        <!-- Authenticated User Chip -->
                        <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,5" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrandPrimaryBrush}" Margin="0,0,8,0">
                                    <TextBlock Text="👤" Foreground="White" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Session.WelcomeName}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Session.RoleBadgeLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" />
                                        <TextBlock Text=" • " FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Session.EmployeeCode}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="Đăng xuất" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="12"
                                Command="{Binding SignOutCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BODY: LEFT RBAC SIDEBAR + MAIN VIEWPORT + RIGHT AI ASSISTANT DRAWER -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- LEFT NAVIGATION SIDEBAR -->
                <Border Grid.Column="0" Background="{StaticResource BrandPrimaryDarkBrush}" Padding="12,16">
                    <DockPanel LastChildFill="True">
                        <!-- Bottom System Version Info -->
                        <Border DockPanel.Dock="Bottom" Background="#14FFFFFF" CornerRadius="8" Padding="12,10" Margin="4,12,4,0">
                            <StackPanel>
                                <TextBlock Text="BIZFLOW DESKTOP v1.0" FontSize="10.5" FontWeight="Bold" Foreground="#93C5FD" />
                                <TextBlock Text=".NET 10 WPF + EF Core + PostgreSQL" FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- TENANT MENU -->
                                <StackPanel Visibility="{Binding ShowTenantMenu, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="ĐIỀU HÀNH &amp; TÁC NGHIỆP" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="14,4,0,8" />

                                    <Button Content="🏠  Không gian làm việc" Style="{StaticResource SidebarNavButtonStyle}"
                                            Command="{Binding NavigateCommand}" CommandParameter="Workspace" />

                                    <Button Content="📋  Quản lý Công việc (Tasks)" Style="{StaticResource SidebarNavButtonStyle}"
                                            Visibility="{Binding CanNavTasks, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding NavigateCommand}" CommandParameter="Tasks" />

                                    <Button Content="📨  Yêu cầu Dịch vụ (Requests)" Style="{StaticResource SidebarNavButtonStyle}"
                                            Visibility="{Binding CanNavRequests, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding NavigateCommand}" CommandParameter="Requests" />

                                    <Button Content="✅  Trung tâm Phê duyệt" Style="{StaticResource SidebarNavButtonStyle}"
                                            Visibility="{Binding CanNavApprovals, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding NavigateCommand}" CommandParameter="Approvals" />

                                    <Button Content="🔀  Quy trình &amp; Workflow Designer" Style="{StaticResource SidebarNavButtonStyle}"
                                            Visibility="{Binding CanNavWorkflows, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding NavigateCommand}" CommandParameter="Workflows" />

                                    <TextBlock Text="PHÂN TÍCH &amp; GIÁM SÁT" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="14,16,0,8" />

                                    <Button Content="📊  Báo cáo &amp; Phân tích" Style="{StaticResource SidebarNavButtonStyle}"
                                            Visibility="{Binding CanNavReports, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding NavigateCommand}" CommandParameter="Reports" />

                                    <Button Content="⏱  Giám sát Cam kết SLA" Style="{StaticResource SidebarNavButtonStyle}"
                                            Visibility="{Binding CanNavSlaMonitor, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding NavigateCommand}" CommandParameter="SlaMonitor" />

                                    <Button Content="🔍  Tìm kiếm Hồ sơ Hợp nhất" Style="{StaticResource SidebarNavButtonStyle}"
                                            Visibility="{Binding CanNavSearch, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding NavigateCommand}" CommandParameter="RecordSearch" />

                                    <TextBlock Text="QUẢN TRỊ &amp; HỆ THỐNG" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="14,16,0,8" />

                                    <Button Content="🏢  Tổ chức, Nhân sự &amp; Cấu hình" Style="{StaticResource SidebarNavButtonStyle}"
                                            Visibility="{Binding CanNavOrganization, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding NavigateCommand}" CommandParameter="Organization" />

                                    <Button Content="🔔  Hộp thư Thông báo" Style="{StaticResource SidebarNavButtonStyle}"
                                            Command="{Binding NavigateCommand}" CommandParameter="Notifications" />

                                    <Button Content="🛡  Nhật ký Kiểm toán (Audit)" Style="{StaticResource SidebarNavButtonStyle}"
                                            Visibility="{Binding CanNavAudit, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding NavigateCommand}" CommandParameter="Audit" />
                                </StackPanel>

                                <!-- PLATFORM ADMIN MENU -->
                                <StackPanel Visibility="{Binding ShowPlatformMenu, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="QUẢN TRỊ NỀN TẢNG (PLATFORM)" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="14,4,0,8" />

                                    <Button Content="🏛  Duyệt Hồ sơ Doanh nghiệp" Style="{StaticResource SidebarNavButtonStyle}"
                                            Command="{Binding NavigateCommand}" CommandParameter="PlatformCompanies" />

                                    <Button Content="🛡  Nhật ký Kiểm toán Nền tảng" Style="{StaticResource SidebarNavButtonStyle}"
                                            Command="{Binding NavigateCommand}" CommandParameter="PlatformAudit" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- MAIN MODULE VIEWPORT -->
                <Grid Grid.Column="1" Background="{StaticResource SurfaceGroundBrush}">
                    <views:DashboardView DataContext="{Binding Dashboard}"
                                         Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualToVis}, ConverterParameter=Workspace}" />

                    <views:TasksView DataContext="{Binding Tasks}"
                                     Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualToVis}, ConverterParameter=Tasks}" />

                    <views:RequestsView DataContext="{Binding Requests}"
                                        Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualToVis}, ConverterParameter=Requests}" />

                    <views:ApprovalsView DataContext="{Binding Approvals}"
                                         Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualToVis}, ConverterParameter=Approvals}" />

                    <views:WorkflowsView DataContext="{Binding Workflows}"
                                         Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualToVis}, ConverterParameter=Workflows}" />

                    <views:OrganizationView DataContext="{Binding Organization}"
                                            Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualToVis}, ConverterParameter=Organization}" />

                    <views:ReportsView DataContext="{Binding Reports}"
                                       Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualToVis}, ConverterParameter=Reports}" />

                    <views:ReportsView DataContext="{Binding Reports}"
                                       Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualToVis}, ConverterParameter=SlaMonitor}" />

                    <views:OperationsView DataContext="{Binding Operations}"
                                          Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualToVis}, ConverterParameter=RecordSearch}" />

                    <views:OperationsView DataContext="{Binding Operations}"
                                          Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualToVis}, ConverterParameter=Notifications}" />

                    <views:OperationsView DataContext="{Binding Operations}"
                                          Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualToVis}, ConverterParameter=Audit}" />

                    <views:OperationsView DataContext="{Binding Operations}"
                                          Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualToVis}, ConverterParameter=PlatformCompanies}" />

                    <views:OperationsView DataContext="{Binding Operations}"
                                          Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualToVis}, ConverterParameter=PlatformAudit}" />
                </Grid>

                <!-- RIGHT COLLAPSIBLE AI ROBOT ASSISTANT DRAWER -->
                <Border Grid.Column="2" Width="410" Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,0,0,0"
                        DataContext="{Binding AiAssistant}"
                        Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Drawer Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="BIZFLOW AI COPILOT" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" />
                                <TextBlock Text="🤖 Trợ lý AI Agent &amp; Tự động hóa" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Làm mới" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Command="{Binding ClearChatCommand}" Margin="0,0,6,0" />
                                <Button Content="✕" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11"
                                        Command="{Binding DataContext.ToggleAiAssistantCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Quick Prompt Chips -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <Button Content="🔔 Kiểm tra thông báo (/notifications)" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,6,6"
                                    Command="{Binding QuickPromptCommand}" CommandParameter="/notifications" />
                            <Button Content="📋 Phân rã công việc mẫu (/task)" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,6,6"
                                    Command="{Binding QuickPromptCommand}" CommandParameter="/task Nâng cấp hệ thống bảo mật và kiểm toán định kỳ" />
                            <Button Content="⚡ Quét cảnh báo AI chủ động" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,0,6"
                                    Command="{Binding TriggerProactiveScanCommand}" />
                        </WrapPanel>

                        <!-- Chat Messages Stream -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding SenderLabel}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource BrandPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Time}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Text}" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Chat Input Box -->
                        <Grid Grid.Row="3" Margin="0,10,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Gửi →" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SendChatCommand}" />
                        </Grid>

                        <!-- Document Summarizer Box -->
                        <Expander Grid.Row="4" Header="📄 Tóm tắt Tài liệu &amp; Trích xuất Hành động bằng AI" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="TIÊU ĐỀ TÀI LIỆU" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding DocumentTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                <TextBlock Text="NỘI DUNG VĂN BẢN" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding DocumentContent, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="64" Margin="0,0,0,6" />
                                <Button Content="✨ Tóm tắt &amp; Trích xuất Action Items" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding SummarizeDocumentCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding DocumentSummaryResult, Mode=OneWay}"
                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="78" VerticalScrollBarVisibility="Auto"
                                         Background="#F8FAFC" />
                            </StackPanel>
                        </Expander>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================================ -->
        <!-- 3. FLOATING TOAST NOTIFICATION OVERLAY (TOP-RIGHT)               -->
        <!-- ================================================================ -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,74,24,0" MaxWidth="440"
                Background="#0F172A" BorderBrush="{StaticResource BrandAccentBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16,12"
                Visibility="{Binding Toast.IsVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding Toast.Title}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12.5" />
                    <TextBlock Text="{Binding Toast.Message}" Foreground="White" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2" FontSize="11" VerticalAlignment="Top"
                        Command="{Binding DismissToastCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
