<UserControl x:Class="BizFlow.Desktop.Views.ApprovalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18">
            <DockPanel Margin="0,0,0,16">
                <Border DockPanel.Dock="Right" Background="{StaticResource HeroBannerGradientBrush}" CornerRadius="12" Padding="18,10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalPendingCount}" FontSize="24" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="CHỜ PHÊ DUYỆT" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="Trung tâm Phê duyệt &amp; Nghiệm thu (Approvals Center)" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="Tập trung đánh giá kết quả bàn giao nhiệm vụ (TASK_CONFIRMATION) và phê duyệt/xác nhận yêu cầu dịch vụ (REQUEST_RESOLUTION)."
                               Foreground="#64748B" FontSize="13" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Filter Pills & Search Toolbar -->
            <Border Style="{StaticResource EnterpriseCardStyle}" Padding="14" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                Command="{Binding SetFilterCommand}" CommandParameter="ALL"
                                Content="Tất cả hồ sơ chờ duyệt" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                Command="{Binding SetFilterCommand}" CommandParameter="TASK"
                                Content="📋 Nghiệm thu Nhiệm vụ" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,14,0"
                                Command="{Binding SetFilterCommand}" CommandParameter="REQUEST"
                                Content="📨 Phê duyệt Yêu cầu" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding LoadCommand}" Content="🔄 Làm mới" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Ghi chú phê duyệt/làm lại:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <TextBox Text="{Binding ApprovalNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Width="220" Margin="0,0,10,0" />
                        <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Width="180" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Approval Cards List -->
            <ItemsControl ItemsSource="{Binding FilteredApprovals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EnterpriseCardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <WrapPanel Margin="0,0,0,6">
                                        <Border Background="#EAF4FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding TypeBadgeLabel}" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" />
                                        </Border>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusToBg}}" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusToFg}}" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="{Binding Priority}" Foreground="{Binding Priority, Converter={StaticResource PriorityToBrush}}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding SubmittedDisplay}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                    </WrapPanel>

                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#071B33" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8" />

                                    <TextBlock FontSize="12.5" Foreground="#64748B">
                                        <Run Text="Người gửi / Thực hiện: " />
                                        <Run Text="{Binding RequesterOrPerformer, Mode=OneWay}" FontWeight="Bold" Foreground="#10243A" />
                                        <Run Text=" · Bộ phận: " />
                                        <Run Text="{Binding DepartmentName, TargetNullValue='Toàn công ty', Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Background="#059669" Margin="0,0,8,0"
                                            Command="{Binding DataContext.QuickApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="✓ Phê duyệt / Nghiệm thu" />
                                    <Button Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0"
                                            Command="{Binding DataContext.QuickRejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="↺ Yêu cầu làm lại / Từ chối" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.InspectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Xem hồ sơ →" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
