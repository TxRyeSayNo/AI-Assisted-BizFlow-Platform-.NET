<UserControl x:Class="BizFlow.Desktop.Views.WorkflowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18">

            <!-- ==========================================================
                 MODE 1: WORKFLOW LIBRARY & VERSION GOVERNANCE
                 ========================================================== -->
            <StackPanel Visibility="{Binding ActiveMode, Converter={StaticResource EqualToVis}, ConverterParameter=Library}">
                <DockPanel Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Thư viện Quy trình &amp; Workflow Designer (Restricted to Company Admin)" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="Quản lý quy trình đa bước cho Yêu cầu (REQUEST) và Nhiệm vụ (TASK) với cơ chế phiên bản bất biến (DRAFT / PUBLISHED)."
                                   Foreground="#64748B" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Create New Workflow Bar -->
                <Border Style="{StaticResource EnterpriseCardStyle}" Background="#F0F7FF" BorderBrush="#93C5FD" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Tên quy trình nghiệp vụ mới *" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding NewWorkflowName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Phân hệ áp dụng (Business Type)" Style="{StaticResource FieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding CreateBusinessTypeOptions}" SelectedItem="{Binding NewWorkflowBusinessType}" Style="{StaticResource ModernComboBoxStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,8,0"
                                Command="{Binding CreateWorkflowCommand}" Content="+ Khởi tạo Quy trình &amp; Mở Designer" />
                        <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"
                                Command="{Binding LoadCommand}" Content="🔄 Làm mới" />
                    </Grid>
                </Border>

                <!-- Workflows Table -->
                <Border Style="{StaticResource EnterpriseCardStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding Workflows}" SelectedItem="{Binding SelectedWorkflow}"
                              Style="{StaticResource EnterpriseDataGridStyle}" MinHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên quy trình" Binding="{Binding Name}" Width="2.2*" FontWeight="Bold" />
                            <DataGridTextColumn Header="Loại nghiệp vụ" Binding="{Binding BusinessType}" Width="120" FontWeight="SemiBold" />
                            <DataGridTemplateColumn Header="Trạng thái" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusToBg}}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusToFg}}" FontSize="11.5" FontWeight="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Phiên bản mới nhất" Binding="{Binding LatestVersionNo}" Width="130" />
                            <DataGridTextColumn Header="Trạng thái Phiên bản" Binding="{Binding LatestVersionStatus}" Width="150" />
                            <DataGridTemplateColumn Header="Thao tác Quản trị" Width="320">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Padding="10,4" FontSize="11.5" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenDesignerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="🎨 Mở Designer" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11.5" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Bật/Tắt" />
                                            <Button Style="{StaticResource DangerButtonStyle}" Padding="10,4" FontSize="11.5"
                                                    Command="{Binding DataContext.DeleteWorkflowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Xóa nháp" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>

            <!-- ==========================================================
                 MODE 2: INTERACTIVE VISUAL WORKFLOW DESIGNER STUDIO
                 ========================================================== -->
            <StackPanel Visibility="{Binding ActiveMode, Converter={StaticResource EqualToVis}, ConverterParameter=Designer}">
                <!-- Designer Top Toolbar -->
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BackToLibraryCommand}" Content="← Thư viện quy trình" Margin="0,0,12,0" />
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                Command="{Binding AutoLayoutCommand}" Content="📐 Tự động căn chỉnh" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                Command="{Binding SaveDraftCommand}" Content="💾 Lưu bản nháp" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                Command="{Binding ValidateWorkflowCommand}" Content="✓ Kiểm tra hợp lệ" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#059669" Margin="0,0,6,0"
                                Command="{Binding PublishWorkflowCommand}" Content="🚀 Xuất bản chính thức (PUBLISH)" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CreateNextVersionCommand}" Content="+ Tạo phiên bản v+1" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Text="{Binding EditableWorkflowName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" FontWeight="Bold" Width="280" Margin="0,0,10,0" />
                        <Border Background="#EAF4FF" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock FontWeight="Bold" Foreground="#17436F" FontSize="12">
                                <Run Text="Phiên bản v" /><Run Text="{Binding CurrentVersion.VersionNo, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding CurrentVersion.Status, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- AI Document-to-Workflow Generator Bar -->
                <Border Style="{StaticResource EnterpriseCardStyle}" Background="#F0F7FF" BorderBrush="#93C5FD" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="🤖 AI TRÍCH XUẤT QUY TRÌNH TỪ VĂN BẢN / TÀI LIỆU MÔ TẢ:" FontSize="11.5" FontWeight="Bold" Foreground="#17436F" Margin="0,0,0,4" />
                            <TextBox Text="{Binding AiWorkflowDocumentText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="54" AcceptsReturn="True" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"
                                Command="{Binding AnalyzeAiWorkflowTextCommand}" Content="✨ AI Thiết kế Sơ đồ vào Canvas" />
                    </Grid>
                </Border>

                <!-- Palette + Visual Canvas + Node Property Inspector -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="310" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Palette: Add Nodes & Connect Transitions -->
                    <Border Grid.Column="0" Style="{StaticResource EnterpriseCardStyle}" Padding="12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="🧩 BẢNG CÔNG CỤ BƯỚC" FontSize="12" FontWeight="Bold" Foreground="#17436F" Margin="0,0,0,8" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" Command="{Binding AddNodeCommand}" CommandParameter="DEPARTMENT" Content="+ Bước Phòng ban" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" Command="{Binding AddNodeCommand}" CommandParameter="APPROVAL" Content="+ Bước Phê duyệt" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" Command="{Binding AddNodeCommand}" CommandParameter="DECISION" Content="+ Phân nhánh Điều kiện" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" Command="{Binding AddNodeCommand}" CommandParameter="CONFIRMATION" Content="+ Bước Xác nhận" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,12" Command="{Binding AddNodeCommand}" CommandParameter="END" Content="+ Điểm Kết thúc" />

                            <TextBlock Text="🔗 TẠO LIÊN KẾT (TRANSITION)" FontSize="12" FontWeight="Bold" Foreground="#17436F" Margin="0,4,0,6" />
                            <TextBlock Text="Từ bước (From):" Style="{StaticResource FieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding DesignerNodes}" SelectedItem="{Binding ConnectFromNode}" DisplayMemberPath="Name" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,6" />
                            <TextBlock Text="Đến bước (To):" Style="{StaticResource FieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding DesignerNodes}" SelectedItem="{Binding ConnectToNode}" DisplayMemberPath="Name" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,6" />
                            <TextBlock Text="Nhãn nhánh:" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding NewEdgeLabel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConnectNodesCommand}" Content="➕ Nối hai bước" />
                        </StackPanel>
                    </Border>

                    <!-- Center Visual Canvas & Transitions Table -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <Border Style="{StaticResource EnterpriseCardStyle}" Background="#F8FAFC" Padding="8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🎨 SƠ ĐỒ TRỰC QUAN CÁC BƯỚC QUY TRÌNH (VISUAL WORKFLOW CANVAS)" FontSize="12" FontWeight="Bold" Foreground="#17436F" Margin="6,4,0,8" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="270">
                                    <ItemsControl ItemsSource="{Binding DesignerNodes}" Width="980" Height="380" Background="#FFFFFF">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Background="#F1F5F9" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="200" Background="White" BorderBrush="#2563EB" BorderThickness="2" CornerRadius="10" Padding="10">
                                                    <StackPanel>
                                                        <Border Background="{Binding TypeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Type}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="#071B33" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding DepartmentName}" FontSize="11" Foreground="#64748B" />
                                                        <TextBlock FontSize="10.5" Foreground="#145DA0" FontWeight="SemiBold">
                                                            <Run Text="SLA: " /><Run Text="{Binding SlaHours}" /><Run Text="h · ID: " /><Run Text="{Binding Id}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Nodes & Edges Selection Lists -->
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource EnterpriseCardStyle}" Padding="10" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Danh sách Bước (Chọn để chỉnh sửa):" FontWeight="Bold" FontSize="12" Foreground="#17436F" Margin="0,0,0,6" />
                                    <ListBox ItemsSource="{Binding DesignerNodes}" SelectedItem="{Binding SelectedNode}" DisplayMemberPath="Name" Height="130" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource EnterpriseCardStyle}" Padding="10" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Danh sách Liên kết Chuyển tiếp (Edges):" FontWeight="Bold" FontSize="12" Foreground="#17436F" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding DesignerEdges}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource DangerButtonStyle}" Padding="6,2" FontSize="11"
                                                            Command="{Binding DataContext.DeleteEdgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Content="✕" />
                                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold">
                                                        <Run Text="{Binding Source}" /><Run Text=" ➔ " /><Run Text="{Binding Target}" />
                                                        <Run Text=" [" /><Run Text="{Binding Label}" /><Run Text="]" />
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Right Property Inspector -->
                    <Border Grid.Column="2" Style="{StaticResource EnterpriseCardStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="⚙️ THUỘC TÍNH BƯỚC ĐANG CHỌN" FontSize="12.5" FontWeight="Bold" Foreground="#17436F" Margin="0,0,0,10" />
                            <StackPanel Visibility="{Binding SelectedNode, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="Tên hiển thị bước *" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding SelectedNode.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" />

                                <TextBlock Text="Loại bước (Node Type)" Style="{StaticResource FieldLabelTextStyle}" />
                                <ComboBox ItemsSource="{Binding NodeTypeOptions}" SelectedItem="{Binding SelectedNode.Type}" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,8" />

                                <TextBlock Text="Phương thức phân công" Style="{StaticResource FieldLabelTextStyle}" />
                                <ComboBox ItemsSource="{Binding AssignmentMethodOptions}" SelectedItem="{Binding SelectedNode.AssignmentMethod}" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,8" />

                                <TextBlock Text="Phòng ban xử lý (Department)" Style="{StaticResource FieldLabelTextStyle}" />
                                <ComboBox ItemsSource="{Binding LookupDepartments}" SelectedValue="{Binding SelectedNode.DepartmentName}" SelectedValuePath="Name" DisplayMemberPath="Name" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,8" />

                                <TextBlock Text="Cam kết thời gian xử lý (SLA giờ)" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding SelectedNode.SlaHours, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" />

                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="Tọa độ X" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding SelectedNode.X, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="Tọa độ Y" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding SelectedNode.Y, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteSelectedNodeCommand}" Content="🗑️ Xóa bước đang chọn" Margin="0,0,0,12" />
                            </StackPanel>

                            <TextBlock Text="🔗 Gắn với Dịch vụ khi Xuất bản:" Style="{StaticResource FieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding LookupServices}" SelectedItem="{Binding PublishAssociateService}" DisplayMemberPath="Name" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,10" />

                            <TextBlock Text="📋 Kết quả Kiểm tra Quy trình:" Style="{StaticResource FieldLabelTextStyle}" />
                            <ItemsControl ItemsSource="{Binding ValidationMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#0B2A4A" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
