<UserControl x:Class="BizFlow.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20">
            <!-- Hero Command Banner -->
            <Border Background="{StaticResource HeroBannerGradientBrush}" CornerRadius="16" Padding="28,24" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Session.CurrentRoleLabel}" Foreground="#93C5FD" FontSize="11.5" FontWeight="Bold" />
                        </Border>
                        <TextBlock FontSize="28" FontWeight="ExtraBold" Foreground="White" Margin="0,0,0,6">
                            <Run Text="Xin chào, " />
                            <Run Text="{Binding Session.WelcomeName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="Hệ thống điều phối công việc, yêu cầu dịch vụ, quy trình phê duyệt và phân tích SLA thời gian thực."
                                   Foreground="#CBD5E1" FontSize="13.5" Margin="0,0,0,18" />

                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Background="#2563EB" Margin="0,0,10,0"
                                    Visibility="{Binding CanCreateTask, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}" CommandParameter="NewTask"
                                    Content="+ Tạo nhiệm vụ mới" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                                    Visibility="{Binding CanCreateRequest, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}" CommandParameter="NewRequest"
                                    Content="+ Tạo yêu cầu dịch vụ" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                                    Visibility="{Binding CanAccessApprovals, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Approvals"
                                    Content="✅ Trung tâm phê duyệt →" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshCommand}"
                                    Content="🔄 Làm mới số liệu" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4 Personalized KPI Metric Cards -->
            <ItemsControl ItemsSource="{Binding KpiCards}" Margin="0,0,0,22">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EnterpriseCardStyle}" Margin="0,0,12,0" Padding="16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Right" Background="#EAF4FF" CornerRadius="10" Padding="8,2">
                                        <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="#145DA0" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Bold" Foreground="#63758B" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding Metric}" FontSize="28" FontWeight="ExtraBold" Foreground="#071B33" Margin="0,2,0,4" />
                                <TextBlock Text="{Binding Sublabel}" FontSize="12" Foreground="#64748B" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Padding="10,5" FontSize="12"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding TargetView}"
                                        Content="{Binding ActionLabel}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Enterprise Modules Grid -->
            <TextBlock Text="Phân hệ chức năng doanh nghiệp" FontSize="18" FontWeight="Bold" Foreground="#071B33" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding ModuleCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EnterpriseCardStyle}" Margin="0,0,12,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding TargetView}"
                                        Content="{Binding ActionLabel}" />
                                <StackPanel>
                                    <Border Width="38" Height="38" CornerRadius="8" Background="#EAF4FF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="Bold" Foreground="#071B33" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="#63758B" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
