<UserControl x:Class="BizFlow.Desktop.Views.OperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280">
    <Grid Margin="24,20">
        <!-- ================================================================ -->
        <!-- 1. UNIFIED RECORD SEARCH (RecordSearch)                          -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding ActiveSection, Converter={StaticResource EqualToVis}, ConverterParameter=RecordSearch}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="TÌM KIẾM HỒ SƠ HỢP NHẤT (TASKS &amp; REQUESTS)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" />
                    <TextBlock Text="Tra cứu toàn diện Công việc &amp; Yêu cầu dịch vụ" Style="{StaticResource PageTitleTextStyle}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="TỪ KHÓA (TIÊU ĐỀ, MÔ TẢ, MÃ HỒ SƠ)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="LOẠI HỒ SƠ" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding SearchTypeOptions}" SelectedItem="{Binding SearchType}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="TRẠNG THÁI" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding SearchStatusOptions}" SelectedItem="{Binding SearchStatus}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="MỨC ƯU TIÊN" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding SearchPriorityOptions}" SelectedItem="{Binding SearchPriority}" />
                    </StackPanel>

                    <CheckBox Grid.Column="4" Content="Bao gồm lưu trữ" IsChecked="{Binding IncludeArchived}" VerticalAlignment="Bottom" Margin="0,0,14,10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />

                    <Button Grid.Column="5" Content="🔍 Tìm kiếm ngay" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExecuteSearchCommand}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding SearchResults}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LOẠI" Binding="{Binding RecordType}" Width="100" FontWeight="Bold" />
                        <DataGridTextColumn Header="TIÊU ĐỀ HỒ SƠ" Binding="{Binding Title}" Width="2*" FontWeight="SemiBold" />
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeBorderStyle}" HorizontalAlignment="Left"
                                            Background="{Binding Status, Converter={StaticResource StatusBg}}">
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusFg}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ƯU TIÊN" Binding="{Binding Priority}" Width="100" FontWeight="Bold" />
                        <DataGridTextColumn Header="PHÒNG BAN" Binding="{Binding DepartmentName}" Width="150" />
                        <DataGridTextColumn Header="NGƯỜI XỬ LÝ" Binding="{Binding AssigneeName}" Width="150" />
                        <DataGridTextColumn Header="CẬP NHẬT" Binding="{Binding UpdatedAtText}" Width="130" />
                        <DataGridTemplateColumn Header="THAO TÁC" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Mở chi tiết →" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11"
                                            Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ================================================================ -->
        <!-- 2. NOTIFICATIONS INBOX (Notifications)                           -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding ActiveSection, Converter={StaticResource EqualToVis}, ConverterParameter=Notifications}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TRUNG TÂM THÔNG BÁO HỆ THỐNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Hộp thư thông báo cá nhân" Style="{StaticResource PageTitleTextStyle}" />
                        <Border Background="#FEE2E2" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UnreadCount, StringFormat='{}{0} chưa đọc'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Chỉ hiển thị thông báo chưa đọc" IsChecked="{Binding UnreadOnly}" VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="SemiBold" />
                    <Button Content="↻ Làm mới" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadNotificationsCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Notifications}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PHÂN LOẠI" Binding="{Binding Type}" Width="140" FontWeight="Bold" />
                        <DataGridTextColumn Header="TIÊU ĐỀ" Binding="{Binding Title}" Width="220" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="NỘI DUNG THÔNG BÁO" Binding="{Binding Body}" Width="2*" />
                        <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding CreatedAtText}" Width="140" />
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#FEF3C7" CornerRadius="6" Padding="8,3" Visibility="{Binding IsUnread, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="CHƯA ĐỌC" FontSize="10" FontWeight="Bold" Foreground="#B45309" />
                                        </Border>
                                        <Border Background="#DCFCE7" CornerRadius="6" Padding="8,3" Visibility="{Binding IsUnread, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="ĐÃ ĐỌC" FontSize="10" FontWeight="Bold" Foreground="#15803D" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="THAO TÁC" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✓ Đánh dấu đã đọc" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11"
                                            Visibility="{Binding IsUnread, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.MarkNotificationReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ================================================================ -->
        <!-- 3. AUDIT LOGS & FORENSIC TRAIL (Audit)                           -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding ActiveSection, Converter={StaticResource EqualToVis}, ConverterParameter=Audit}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="NHẬT KÝ KIỂM TOÁN &amp; TRUY VẾT BẢO MẬT (AUDIT LOG)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" />
                    <TextBlock Text="Lịch sử sự kiện hệ thống &amp; Trình kiểm tra Payload JSON" Style="{StaticResource PageTitleTextStyle}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="LỌC THEO MÃ HÀNH ĐỘNG (VD: auth.login, task.created, request.resolved)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding AuditActionFilter, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="LOẠI TÁC NHÂN (ACTOR TYPE)" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding ActorTypeOptions}" SelectedItem="{Binding AuditActorTypeFilter}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="🔍 Lọc nhật ký" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadAuditLogsCommand}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding AuditLogs}" SelectedItem="{Binding SelectedAuditEvent, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding CreatedAtText}" Width="145" />
                            <DataGridTextColumn Header="HÀNH ĐỘNG" Binding="{Binding Action}" Width="180" FontWeight="Bold" />
                            <DataGridTextColumn Header="ĐỐI TƯỢNG" Binding="{Binding EntityType}" Width="120" />
                            <DataGridTextColumn Header="TÁC NHÂN" Binding="{Binding ActorLabel}" Width="*" />
                            <DataGridTextColumn Header="LOẠI" Binding="{Binding ActorType}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel DataContext="{Binding SelectedAuditEvent}">
                        <TextBlock Text="CHI TIẾT SỰ KIỆN KIỂM TOÁN (JSON INSPECTOR)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" />
                        <TextBlock Text="{Binding Action, FallbackValue='Chọn một dòng sự kiện bên trái'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,12" />

                        <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding AuditId, StringFormat='Audit ID: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ActorLabel, StringFormat='Tác nhân: {0}'}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding EntityType, StringFormat='Thực thể: {0}'}" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding EntityId, StringFormat='Entity ID: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding CorrelationId, StringFormat='Correlation ID: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="METADATA PAYLOAD (JSON)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding MetadataJson, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Height="320"
                                 Background="#0F172A"
                                 Foreground="#E2E8F0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================================ -->
        <!-- 4. PLATFORM ADMIN: COMPANY REGISTRATIONS (PlatformCompanies)     -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding ActiveSection, Converter={StaticResource EqualToVis}, ConverterParameter=PlatformCompanies}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="QUẢN TRỊ NỀN TẢNG (PLATFORM ADMIN)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" />
                    <TextBlock Text="Phê duyệt Hồ sơ Đăng ký Doanh nghiệp &amp; Cấp phát Tenant Workspace" Style="{StaticResource PageTitleTextStyle}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="TÌM KIẾM DOANH NGHIỆP (TÊN, MÃ, EMAIL, MÃ SỐ THUẾ)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding CompanySearch, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="TRẠNG THÁI HỒ SƠ" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding CompanyStatusOptions}" SelectedItem="{Binding CompanyStatusFilter}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="🔍 Tải danh sách" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadCompaniesCommand}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding CompanyRegistrations}" SelectedItem="{Binding SelectedCompany, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ DN" Binding="{Binding Code}" Width="105" FontWeight="Bold" />
                            <DataGridTextColumn Header="TÊN DOANH NGHIỆP" Binding="{Binding Name}" Width="1.5*" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="TENANT KEY" Binding="{Binding TenantKey}" Width="130" />
                            <DataGridTextColumn Header="EMAIL LIÊN HỆ" Binding="{Binding ContactEmail}" Width="180" />
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeBorderStyle}" HorizontalAlignment="Left"
                                                Background="{Binding Status, Converter={StaticResource StatusBg}}">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusFg}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="NGÀY ĐĂNG KÝ" Binding="{Binding CreatedAtText}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Provisioning & Status Drawer -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="HỒ SƠ PHÁP LÝ &amp; CẤP PHÁT TENANT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" />
                            <TextBlock Text="{Binding SelectedCompany.Name, FallbackValue='Chọn doanh nghiệp'}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,10" />

                            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedCompany.RepresentativeFullName, StringFormat='Đại diện pháp luật: {0}'}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding SelectedCompany.RepresentativeTitle, StringFormat='Chức danh: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding SelectedCompany.ContactEmail, StringFormat='Email liên hệ: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding SelectedCompany.ContactPhone, StringFormat='Điện thoại: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding SelectedCompany.BusinessLicenseFileName, StringFormat='Giấy phép ĐKKD: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="1. CẤP PHÁT WORKSPACE &amp; TÀI KHOẢN COMPANY ADMIN" Style="{StaticResource SectionHeaderTextStyle}" FontSize="13" Margin="0,0,0,8" />

                            <TextBlock Text="TENANT KEY (ĐỊNH DANH WORKSPACE)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ApproveTenantKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MÃ NV ADMIN" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ApproveAdminCode, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="HỌ TÊN ADMIN" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ApproveAdminName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="EMAIL ĐĂNG NHẬP ADMIN" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ApproveAdminEmail, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MẬT KHẨU KHỞI TẠO" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ApproveAdminPassword, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Button Content="✓ Phê duyệt &amp; Khởi tạo Tenant Workspace" Style="{StaticResource SuccessButtonStyle}" Command="{Binding ApproveCompanyCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                            <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,12" />

                            <TextBlock Text="2. TỪ CHỐI HỒ SƠ HOẶC ĐIỀU KHIỂN TRẠNG THÁI" Style="{StaticResource SectionHeaderTextStyle}" FontSize="13" Margin="0,0,0,8" />
                            <TextBlock Text="LÝ DO TỪ CHỐI HỒ SƠ" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RejectCompanyReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                            <WrapPanel>
                                <Button Content="✕ Từ chối hồ sơ" Style="{StaticResource DangerButtonStyle}" Command="{Binding RejectCompanyCommand}" Margin="0,0,8,8" />
                                <Button Content="⏸ Tạm khóa (SUSPENDED)" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding UpdateCompanyStatusCommand}" CommandParameter="SUSPENDED" Margin="0,0,8,8" />
                                <Button Content="▶ Kích hoạt lại (ACTIVE)" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding UpdateCompanyStatusCommand}" CommandParameter="ACTIVE" Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
