<UserControl x:Class="BizFlow.Desktop.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#F0F6FD" MinHeight="680">
            <Grid MaxWidth="980" Margin="32,24" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <!-- Left Brand Introduction Panel -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,36,0">
                    <Border Background="#EAF4FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="16" Padding="12,5" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="BIZFLOW ENTERPRISE PLATFORM · WPF DESKTOP" FontSize="11.5" FontWeight="Bold" Foreground="#17436F" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Image Source="/Assets/bizflow-logo.png" Width="46" Height="46" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BizFlow" FontSize="30" FontWeight="ExtraBold" Foreground="#071B33" />
                            <TextBlock Text="Nền tảng Điều phối Công việc &amp; Quy trình Thông minh" FontSize="13" Foreground="#145DA0" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Quản trị tập trung Nhiệm vụ, Yêu cầu Dịch vụ, Phê duyệt Đa cấp, Thiết kế Quy trình và Trợ lý AI Doanh nghiệp."
                               FontSize="14.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,22" />

                    <!-- Quick One-Click Demo Role Switcher Card -->
                    <Border Style="{StaticResource EnterpriseCardStyle}" Background="#FFFFFF" BorderBrush="#BFDBFE">
                        <StackPanel>
                            <TextBlock Text="⚡ ĐĂNG NHẬP NHANH THEO VAI TRÒ (KẾT NỐI TRỰC TIẾP POSTGRESQL &amp; EF CORE)"
                                       FontSize="11.5" FontWeight="Bold" Foreground="#17436F" Margin="0,0,0,10" />
                            <UniformGrid Columns="2" Rows="2">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"
                                        Command="{Binding QuickLoginCommand}" CommandParameter="ADMIN"
                                        Content="👑 Company Admin (ADMIN001)" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,6"
                                        Command="{Binding QuickLoginCommand}" CommandParameter="MANAGER"
                                        Content="👔 Trưởng phòng (MGR001)" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,6,6,0"
                                        Command="{Binding QuickLoginCommand}" CommandParameter="EMPLOYEE"
                                        Content="👤 Nhân viên (EMP001)" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="6,6,0,0"
                                        Command="{Binding QuickLoginCommand}" CommandParameter="SUPERADMIN"
                                        Content="🌐 Platform Admin (SUPERADMIN)" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Authentication Card -->
                <Border Grid.Column="1" Background="White" BorderBrush="#93C5FD" BorderThickness="2" CornerRadius="18" Padding="28">
                    <StackPanel>
                        <!-- Mode Tabs -->
                        <UniformGrid Columns="3" Margin="0,0,0,18">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                    Command="{Binding SwitchScreenCommand}" CommandParameter="Login"
                                    Content="🔑 Mật khẩu" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="2,0,2,0"
                                    Command="{Binding SwitchScreenCommand}" CommandParameter="EmailLink"
                                    Content="✉️ Email Link" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0"
                                    Command="{Binding SwitchScreenCommand}" CommandParameter="RegisterCompany"
                                    Content="🏢 Đăng ký ĐN" />
                        </UniformGrid>

                        <!-- Error & Success Banners -->
                        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="12.5" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </Border>

                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                                Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding SuccessMessage}" Foreground="#065F46" FontSize="12.5" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </Border>

                        <!-- 1. PASSWORD LOGIN SCREEN -->
                        <StackPanel Visibility="{Binding ActiveScreen, Converter={StaticResource EqualToVis}, ConverterParameter=Login}">
                            <TextBlock Text="Đăng nhập Hệ thống BizFlow" FontSize="20" FontWeight="Bold" Foreground="#17436F" Margin="0,0,0,4" />
                            <TextBlock Text="Nhập mã nhân viên hoặc email công ty cùng mã không gian làm việc." FontSize="12.5" Foreground="#64748B" Margin="0,0,0,16" />

                            <TextBlock Text="Mã nhân viên hoặc Email công ty *" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="Mật khẩu *" Style="{StaticResource FieldLabelTextStyle}" />
                            <PasswordBox x:Name="LoginPasswordBox" Style="{StaticResource ModernPasswordBoxStyle}" FontFamily="Consolas" PasswordChanged="OnLoginPasswordChanged" Margin="0,0,0,12" />

                            <StackPanel Visibility="{Binding IsSuperAdminIdentifier, Converter={StaticResource InvBoolToVis}}" Margin="0,0,0,16">
                                <TextBlock Text="Mã không gian làm việc (Tenant Key) *" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding TenantKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                <TextBlock Text="Mặc định: bizflow-corp (Không bắt buộc với tài khoản SUPERADMIN)" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" />
                            </StackPanel>

                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoginCommand}" Content="Đăng nhập vào Không gian làm việc →" Margin="0,4,0,12" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12"
                                        Command="{Binding SwitchScreenCommand}" CommandParameter="ForgotPassword"
                                        Content="Quên mật khẩu?" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Margin="8,0,0,0"
                                        Command="{Binding SwitchScreenCommand}" CommandParameter="ResetPassword"
                                        Content="Đặt lại mật khẩu bằng Token" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 2. PASSWORDLESS EMAIL-LINK & WORKSPACE SELECTOR SCREEN -->
                        <StackPanel Visibility="{Binding ActiveScreen, Converter={StaticResource EqualToVis}, ConverterParameter=EmailLink}">
                            <TextBlock Text="Đăng nhập Không mật khẩu (Email Link)" FontSize="19" FontWeight="Bold" Foreground="#17436F" Margin="0,0,0,6" />
                            <TextBlock Text="Nhận liên kết xác thực qua email công ty hoặc xác minh token." FontSize="12.5" Foreground="#64748B" Margin="0,0,0,14" />

                            <TextBlock Text="Địa chỉ Email doanh nghiệp *" Style="{StaticResource FieldLabelTextStyle}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding EmailLinkAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding RequestEmailLinkCommand}" Content="Gửi liên kết" />
                            </Grid>

                            <TextBlock Text="Hoặc nhập Mã Token xác thực Email / Firebase:" Style="{StaticResource FieldLabelTextStyle}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding EmailLinkToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding VerifyEmailLinkCommand}" Content="Xác minh" />
                            </Grid>

                            <StackPanel Visibility="{Binding SelectedWorkspaceCandidate, Converter={StaticResource NullToVis}}" Margin="0,8,0,0">
                                <TextBlock Text="Chọn Không gian làm việc:" Style="{StaticResource FieldLabelTextStyle}" />
                                <ComboBox ItemsSource="{Binding WorkspaceCandidates}" SelectedItem="{Binding SelectedWorkspaceCandidate}"
                                          DisplayMemberPath="TenantName" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,10" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmWorkspaceSelectionCommand}" Content="Vào Không gian làm việc đã chọn" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 3. FORGOT PASSWORD SCREEN -->
                        <StackPanel Visibility="{Binding ActiveScreen, Converter={StaticResource EqualToVis}, ConverterParameter=ForgotPassword}">
                            <TextBlock Text="Khôi phục Mật khẩu" FontSize="19" FontWeight="Bold" Foreground="#17436F" Margin="0,0,0,6" />
                            <TextBlock Text="Mã nhân viên hoặc Email *" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding ResetIdentifier, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10" />
                            <TextBlock Text="Mã không gian làm việc (Tenant Key)" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding ResetTenantKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,14" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ForgotPasswordCommand}" Content="Gửi yêu cầu khôi phục mật khẩu" Margin="0,0,0,10" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SwitchScreenCommand}" CommandParameter="Login" Content="← Quay lại Đăng nhập" />
                        </StackPanel>

                        <!-- 4. RESET PASSWORD SCREEN -->
                        <StackPanel Visibility="{Binding ActiveScreen, Converter={StaticResource EqualToVis}, ConverterParameter=ResetPassword}">
                            <TextBlock Text="Đặt lại Mật khẩu Mới" FontSize="19" FontWeight="Bold" Foreground="#17436F" Margin="0,0,0,8" />
                            <TextBlock Text="Mã nhân viên hoặc Email *" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding ResetIdentifier, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" />
                            <TextBlock Text="Mã không gian làm việc" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding ResetTenantKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" />
                            <TextBlock Text="Reset Token *" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding ResetToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" />
                            <TextBlock Text="Mật khẩu mới *" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ResetPasswordCommand}" Content="Xác nhận Đổi Mật khẩu" Margin="0,0,0,8" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SwitchScreenCommand}" CommandParameter="Login" Content="← Quay lại Đăng nhập" />
                        </StackPanel>

                        <!-- 5. PUBLIC COMPANY REGISTRATION SCREEN -->
                        <StackPanel Visibility="{Binding ActiveScreen, Converter={StaticResource EqualToVis}, ConverterParameter=RegisterCompany}">
                            <TextBlock Text="Đăng ký Không gian Doanh nghiệp Mới" FontSize="18.5" FontWeight="Bold" Foreground="#17436F" Margin="0,0,0,10" />

                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="1. Mã số thuế *" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding RegTaxId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="2. Tên doanh nghiệp *" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding RegCompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="3. Mã không gian làm việc (Workspace Code) *" Style="{StaticResource FieldLabelTextStyle}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding RegWorkspaceCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" Command="{Binding CheckCodeCommand}" Content="Kiểm tra" />
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" Command="{Binding GenerateCodeCommand}" Content="Tạo ngẫu nhiên" />
                            </Grid>
                            <TextBlock Text="{Binding CodeCheckFeedback}" FontSize="11.5" FontWeight="SemiBold" Foreground="#145DA0" Margin="0,0,0,8" />

                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="4. Người đại diện *" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding RegContactPerson, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="5. Điện thoại liên hệ *" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding RegContactPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="6. Email liên hệ doanh nghiệp *" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding RegContactEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10" />

                            <Border Background="#F8FBFF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding UploadEvidenceDocumentCommand}" Content="📄 Chọn tệp minh chứng" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Hồ sơ pháp lý / Giấy phép kinh doanh (PDF, PNG, JPG)" FontSize="12" FontWeight="SemiBold" Foreground="#0B2A4A" />
                                        <TextBlock Text="{Binding RegEvidenceFileName, TargetNullValue='Chưa tải tệp minh chứng'}" FontSize="11.5" Foreground="#059669" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SubmitCompanyRegistrationCommand}" Content="Gửi Hồ sơ Đăng ký Doanh nghiệp" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
